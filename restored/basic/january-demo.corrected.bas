705 & ERASE; HOME 0,20
710 & CLIP0,40,0,192
715 & SET1 TO #5
720 FOR I = 15 TO 19
725 & SET3 TO #I: NEXT
730 RETURN
750 REM << DECLARE >>
755 INKEY = -16384:STRB = -16368
760 X = 20:Y = 100:MV = -1
765 UX = 20:UY = 0:UA = 1
