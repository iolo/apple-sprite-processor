610 & PAGE2;MOVE3 TO 2
615 & PUT#5,(20,Y),1:UX = 20
620 GOSUB 385:OPEN = 0
625 & SHOW( FN R(3) + 1,70)
630 FOR UY = 100 TO 10 STEP -2
635 GOSUB 385:OPEN = 1
640 & PROCESS
645 NEXT :SHOW% = 0
650 FIRE = 0:BOMB = 0:LIGHT = 0
655 RETURN
