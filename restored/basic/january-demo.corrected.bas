200 REM << FIGHTER CONTROL >>
205 KB = PEEK (INKEY): IF KBD > 127 THEN POKE STRB,0
210 IF KB = 136 THEN MV = 1
215 IF KB = 149 THEN MV = 0
220 IF KB = 141 THEN MV = -1
225 IF KB = 155 THEN POKE STRB,0: WAIT INKEY,128: POKE STRB,0
230 LET X = X - 1 * (X > 1) * (MV = 1) + 1 * (X < 38) * (MV = 0)
235 IF KB = 160 AND FY < 135 THEN CALL 768:FIRE = 1:FX = X:FY = Y + 3
240 IF FIRE THEN FY = FY - 15: & PUT#7,(FX,FY),2: IF FY < 0 THEN FIRE = 0: & ERASE#7
245 IF SC > 500 AND NOT TWO THEN GOSUB 450:TWO = 1
250 IF POG THEN CNT = CNT - 1: CALL 798
255 IF SHOW% THEN GOSUB 600
260 IF CNT < 0 THEN GOSUB 500
265 & PUT#5,(X,Y): IF TWO THEN & PUT#3,(X,Y - 5)
270 RETURN :
300 REM << U.F.O. MOVE >>
305 IF UY < 10 THEN UA = 2
310 IF UY > 120 THEN UA = -2
315 UY = UY + UA
320 IF UFO% THEN UCNT = UCNT - 1: GOTO 335
325 & GET #15 TO 987: IF PEEK (987) = 0 THEN UFO = 0
330 IF UFO = 0 THEN UCNT = 5:UFO = -1: FOR I = 1 TO 5: & SET7 TO #14 + I: NEXT :UFO% = 1: CALL 798
335 IF UCNT < 0 THEN UFO = 5:UY = 5:UA = 1: FOR I = 1 TO UFO: & SET5 TO #14 + I: NEXT :UCNT = 0:UFO% = 0
340 UR = FN R(15)
345 IF UN THEN UX = UX + 2: IF UX > 36 OR UR = 7 THEN UN = 0:UX = UX - 2
350 IF NOT UN THEN UX = UX - 2: IF UX < 3 OR UR = 7 THEN UN = 1
355 IF (NOT LIGHT) AND (X = UX) OR (NOT LIGHT) AND FN R(15) = 9 THEN LIGHT = 1:LX = UX:LY = UY:LA = 0: CALL 768:OPEN = 1
360 IF NOT BOMB AND FN R(10) = 7 AND UY < 130 THEN BOMB = 1:BX = UX:BY = UY:BA = (X - BX) / ((Y - BY) / 8): & SET5 TO #25: CALL 768:OPEN = 1
365 IF LIGHT THEN LY = LY + 20:LX = LX + LA: & PUT#20,(LX,LY),6;PUT#21,(LX - 1,LY - 8),6;PUT#22,(LX + 1,LY - 16),6
370 IF BOMB THEN BY = BY + 8:BX = BX + BA: & PUT#25,(BX,BY)
375 IF LY > 210 THEN LIGHT = 0: & ERASE#20;ERASE#21;ERASE#22
380 IF BY > 210 THEN BOMB = 0: & ERASE#25
385 IF OPEN THEN & PUT#15,(UX,UY);PUT#16,(UX - 2,UY);PUT#17,(UX + 2,UY);PUT#18,(UX,UY - 7);PUT#19,(UX,UY + 7):OPEN = 0: GOTO 395
390 & PUT#15,(UX,UY);PUT#16,(UX - 1,UY);PUT#17,(UX + 1,UY);PUT#18,(UX,UY - 5);PUT#19,(UX,UY + 5)
395 RETURN
400 REM << CHECK ROUTINE >>
405 & CMP(15,25) - (7):PLANE = PEEK (901):SPRITE = PEEK (902): IF PEEK (900) THEN & SET7 TO #PLANE: CALL 798:SC = SC + FN R(11) * 10: IF SPRITE = 3 THEN UFO = UFO - 1
410 & CMP(20,25) - (5): IF PEEK (900) THEN POG = 1: & SET7 TO # PEEK (901): & SET7 TO #5:CNT = 2: IF TWO THEN & SET7 TO #3:SC = 0
415 RETURN
450 REM << TWO SHIP >>
455 & PUT#5,(X,Y)
460 FOR I = 200 TO Y - 15 STEP -1: & PUT#6,(X,I),1;PROCESS: CALL 768: NEXT : & ERASE#6
465 FOR I = Y - 15 TO Y - 5 STEP 1: & PUT#3,(X,I),1;PROCESS: CALL 768: NEXT
470 FOR I = 1 TO 3: CALL 798: NEXT
475 RETURN
500 REM << READY FIGHT >>
505 HOME : VTAB 22: HTAB 8
510 PRINT "PRESS ANY KEY TO PLAY": & MODE0
515 POKE STRB,0: FOR I = 1 TO 1000
520 IF PEEK (INKEY) > 127 THEN POKE STRB,0: GOTO 530
525 NEXT
530 POG = 0:CNT = 0:UY = 10:X = 19:SHOW% = 1:TWO = 0
535 BOMB = 0:LIGHT = 0
