0 REM -= EXAMPLE 1 =-
1 HIMEM: 8192:D$ = CHR$ (4)
2 IF PEEK (34560) < > 76 THEN PRINT D$"BRUN ASP V1.0"
3 PRINT D$"BLOAD GET-UTILITY"
10 REM -= START PROGRAM =-
15 HOME : & PAGE1
20 & MODE2; CLEAR 1
25 VTAB 21: HTAB 1: PRINT "MAIN PATTERN";: HTAB 21: PRINT "SUB PATTERN"
30 FOR I = 0 TO 130
35 HCOLOR= 3: HPLOT 139,I TO 23 * 7,I
40 NEXT
45 DEF FN R(R) = RND (1) * R
100 REM -= DRAW PATTERNS =-
105 READ X,Y,R,C:A = X:B = Y
110 HCOLOR= C
115 IF R = 0 THEN 300
120 GOSUB 1000: REM -= MAIN =-
125 HCOLOR= 0
130 LET A = X + 7 * 20
135 IF C = 0 OR C = 4 THEN HCOLOR= 3
140 GOSUB 1000: REM -= SUB =-
145 GOTO 105
150 DATA 10,10,10,2,10,10,5,1
155 DATA 10,50,10,3,10,50,7,0
160 DATA 0,0,0,0
300 REM -= GET SPRITE =-
305 LET BASE = 24576
310 CALL 768;0,0,3,21,BASE
315 LET NXT = BASE + 3 * 21
320 CALL 768;20,0,3,21,NXT
325 LET NXT = BASE + 3 * 21 * 2
330 CALL 768;0,40,3,21,NXT
335 LET NXT = BASE + 3 * 21 * 3
340 CALL 768;20,40,3,21,NXT
500 REM -= DEFINE SPRITE =-
510 LET NXT = BASE + 3 * 21 * 2
520 & SPRITE$(1) = 3,21,BASE
530 & SPRITE$(2) = 3,21,NXT
700 REM -= DRAW BACKGROUND =-
705 VTAB 23: HTAB 9: PRINT "HIT ANY KEY ..";: POKE -16368,0: WAIT -16384,128
710 & CLEAR 1;MODE2,1,0;ERASE
715 FOR I = 1 TO 150
720 HCOLOR= 3
725 HPLOT FN R(280), FN R(192)
730 NEXT
735 & MOVE1 TO 3;MOVE1 TO 2
740 FOR I = 10 TO 30
745 & PUT#I,( FN R(35) + 3, FN R(100) + 25), FN R(2) + 1
750 NEXT
900 REM -= MOVE SPRITE =-
905 FOR L = 1 TO 50
910 LET Y = FN R(100) + 25
915 LET P = FN R(2) + 1
920 FOR X = -5 TO 45
925 & PUT#25,(X,Y),P
930 & PROCESS
935 NEXT X
940 & SWAP(1,2)
945 NEXT
950 END
1000 REM -= DRAW CIRCLE =-
1005 LET PHI = 0:Y1 = 0:X1 = R
1010 LET PY = PHI + Y1 + Y1 + 1:XY = PY - X1 - X1 + 1
1015 HPLOT A + X1,B + Y1 TO A - X1,B + Y1
1020 HPLOT A + X1,B - Y1 TO A - X1,B - Y1
1025 HPLOT A + Y1,B + X1 TO A - Y1,B + X1
1030 HPLOT A + Y1,B - X1 TO A - Y1,B - X1
1035 LET PHI = PY:Y1 = Y1 + 1
1040 IF ABS (XY) < ABS (PY) THEN PHI = XY:X1 = X1 - 1
1045 IF X1 > = Y1 THEN 1010
1050 RETURN
